---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Music Lessons | Cincinnati School of Music"
  description="The August 2026 Back-to-School promotion has ended. Book a free Intro Lesson to get started with Cincinnati School of Music."
  canonicalPath="/book-intro/"
  noindex={true}
>
  <section class="retired-campaign" aria-labelledby="retired-campaign-title">
    <div class="retired-card">
      <p class="retired-kicker">August promotion ended</p>
      <h1 id="retired-campaign-title">Ready to start music lessons?</h1>
      <p>
        Our August 2026 Back-to-School promotion has ended. You can still start with a free Intro Lesson
        and we’ll help you find the right teacher, location, and weekly time.
      </p>
      <a class="retired-cta" href="/book-intro/">Book a Free Intro Lesson</a>
    </div>
  </section>

  <style>
    .retired-campaign {
      max-width: 760px;
      margin: 0 auto;
      padding: 5rem 1.5rem;
    }

    .retired-card {
      text-align: center;
    }

    .retired-kicker {
      margin: 0 0 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .retired-card h1 {
      margin-bottom: 1rem;
    }

    .retired-card p {
      margin: 0 auto 1.75rem;
      max-width: 640px;
    }

    .retired-cta {
      display: inline-block;
      padding: 0.85rem 1.2rem;
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 700;
    }
  </style>
</Base>
