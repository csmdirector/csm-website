---
import Base from '../../layouts/Base.astro';
import { INTRO_LOCATIONS, INTRO_SERVICES, introBookingUrl } from '../../../shared/intro-bridge-config.js';

const routes = Object.fromEntries(INTRO_SERVICES.map((service) => [service.slug, {
  name: service.displayName,
  introName: service.introName,
  locations: Object.fromEntries(INTRO_LOCATIONS.map((location) => [location.slug, {
    name: location.name,
    bookingUrl: introBookingUrl(service, location)
  }]))
}]));
---
<Base
  title="Choose Your Intro Time | Cincinnati School of Music"
  description="Pick an available time and finish booking your free 30-minute intro lesson."
  canonicalPath="/book-intro/thank-you/"
  noindex={true}
>
  <section class="confirmation-shell">
    <div class="confirmation-card">
      <div class="confirmation-mark" aria-hidden="true">✓</div>
      <span class="section-label" id="confirmationLabel">Almost There</span>
      <h1 id="confirmationHeading">Great. Let’s find a time.</h1>
      <p class="lead" id="confirmationLead">Pick a time that works and you’re done.</p>
      <p class="detail-copy" id="detailCopy">Your intro lesson is free, 30 minutes, and there’s no ongoing commitment.</p>
      <a class="btn-a choose-time" id="chooseTimeLink" href="/book-intro/" aria-disabled="true" hidden>See Available Times</a>
      <div class="support-actions">
        <span>Need a hand?</span>
        <a href="tel:5135609175">Call (513) 560-9175</a>
        <a href="sms:5135609175">Text us</a>
        <a href="mailto:info@cincinnatischoolofmusic.com">Email us</a>
      </div>
    </div>
  </section>
  <style>
    .confirmation-shell{min-height:72vh;display:flex;align-items:center;justify-content:center;padding:74px 24px 90px;background:linear-gradient(180deg,var(--offwhite),#fff)}
    .confirmation-card{width:min(100%,760px);text-align:left;background:var(--white);border:1px solid var(--offwb);padding:54px 58px;box-shadow:0 24px 64px rgba(25,28,30,.07)}
    .confirmation-mark{width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 0 24px;background:#fff3f3;border:1px solid #ffd5d7;color:var(--accent);font-size:1.35rem;font-weight:700}
    .confirmation-card .section-label{color:var(--accent)}
    .confirmation-card h1{max-width:610px;margin:8px 0 18px}
    .lead{max-width:640px;margin:0;font-size:1rem;line-height:1.75;color:var(--mid)}
    .detail-copy{max-width:640px;margin:14px 0 0;font-size:.82rem;line-height:1.65;color:#777570}
    .choose-time{border:0;cursor:pointer;width:100%;text-align:center;margin-top:32px}
    .choose-time[hidden]{display:none}
    .choose-time[aria-disabled="true"]{opacity:.5;pointer-events:none}
    .support-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px 20px;margin-top:30px;padding-top:24px;border-top:1px solid var(--offwb)}
    .support-actions span{font-size:.73rem;color:var(--mid)}
    .support-actions a{font-size:.69rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);text-decoration:none}
    @media(max-width:620px){.confirmation-shell{align-items:flex-start;padding:36px 16px 64px}.confirmation-card{padding:40px 24px}.support-actions{align-items:flex-start;flex-direction:column}}
  </style>
  <script define:vars={{ routes }}>
    (function(){
      var params = new URLSearchParams(window.location.search);
      var service = routes[params.get('service') || ''];
      var location = service && service.locations[params.get('location') || ''];
      var link = document.getElementById('chooseTimeLink');
      var label = document.getElementById('confirmationLabel');
      var heading = document.getElementById('confirmationHeading');
      var lead = document.getElementById('confirmationLead');
      var detail = document.getElementById('detailCopy');
      if(params.get('existing_family') === '1'){
        label.textContent = 'You’re all set';
        heading.textContent = 'We’ll help you from here.';
        lead.textContent = 'You’re already with us, so we’ll set this up on our end and keep it lined up with your current schedule.';
        detail.textContent = 'We have what we need. Our office will be in touch.';
      } else if(service && location){
        lead.textContent = 'Pick an available ' + service.name.toLowerCase() + ' time at ' + location.name + ' and you’re done.';
        link.href = location.bookingUrl;
        link.textContent = 'See Free ' + service.name + ' Times';
        link.setAttribute('aria-disabled','false');
        link.hidden = false;
      } else {
        label.textContent = 'Let’s back up';
        heading.textContent = 'Let’s pick that again.';
        lead.textContent = 'Tell us the lesson and location and we’ll show the right times.';
        detail.textContent = '';
        link.href = '/book-intro/';
        link.textContent = 'Choose a Lesson';
        link.setAttribute('aria-disabled','false');
        link.hidden = false;
      }
    })();
  </script>
</Base>
