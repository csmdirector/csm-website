---
import Base from '../../layouts/Base.astro';
import {
  INTRO_LOCATIONS,
  INTRO_SERVICES,
  introBookingUrl
} from '../../../shared/intro-bridge-config.js';

const services = INTRO_SERVICES.map((service) => ({
  slug: service.slug,
  name: service.displayName,
  introName: service.introName,
  ageMin: service.ageMin,
  ageMax: service.ageMax
}));
const locations = INTRO_LOCATIONS.map((location) => ({ slug: location.slug, name: location.name }));
const bookingRoutes = Object.fromEntries(INTRO_SERVICES.map((service) => [
  service.slug,
  Object.fromEntries(INTRO_LOCATIONS.map((location) => [location.slug, introBookingUrl(service, location)]))
]));
---
<Base
  title="Book a Free Intro Lesson | Cincinnati School of Music"
  description="Choose an instrument, location, and free 30-minute Intro Lesson at Cincinnati School of Music."
  canonicalPath="/book-intro/"
  noindex={true}
>
  <section class="booking-hero">
    <div class="booking-hero-inner">
      <span class="section-label">Fall in Love With Music Special</span>
      <h1 id="heroHeading">Find Your Free Intro Lesson</h1>
      <p class="intro-copy">
        Choose what you’d like to try, tell us about the student, and we’ll show you the right next step.
      </p>
      <p class="intro-reassurance">Free 30-minute intro · No ongoing commitment</p>
    </div>
  </section>

  <section class="booking-section">
    <div class="booking-column">
      <form class="booking-card" id="introBridgeForm" novalidate>
        <input type="hidden" name="form-name" value="intro-bridge" />
        <input type="hidden" name="client_submission_id" id="clientSubmissionId" />
        <input type="hidden" name="submitted_at" id="submittedAt" />
        <input type="hidden" name="attribution_json" id="attributionJson" />
        <p class="hidden-field" aria-hidden="true">
          <label>Leave this blank <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="progress-wrap" aria-label="Intro booking progress">
          <div class="progress-copy">
            <span id="progressEyebrow">Step 1 of 5</span>
            <span id="progressStatus" aria-live="polite">Choose a lesson</span>
          </div>
          <ol class="progress-steps" id="progressSteps">
            <li class="is-current"><span>1</span><small>Lesson</small></li>
            <li><span>2</span><small>Age</small></li>
            <li><span>3</span><small>Location</small></li>
            <li><span>4</span><small>Details</small></li>
            <li><span>5</span><small>Next step</small></li>
          </ol>
        </div>

        <div class="step-panel is-active" data-step="1">
          <div class="step-heading" tabindex="-1">
            <span class="step-kicker">Let’s get started</span>
            <h2>What would you like to try?</h2>
            <p>Choose one and we’ll tailor the rest.</p>
          </div>
          <fieldset>
            <legend class="visually-hidden">Choose an instrument or program</legend>
            <div class="service-grid">
              {services.map((service) => (
                <label class="choice-card service-card">
                  <input type="radio" name="service_slug" value={service.slug} required />
                  <span>{service.name}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <p class="selection-hint">Your selection will take you to the next question.</p>
        </div>

        <div class="step-panel" data-step="2" hidden>
          <div class="step-heading" tabindex="-1">
            <span class="step-kicker">About the student</span>
            <h2>How old is the student?</h2>
            <p>Age helps us show the right lesson options.</p>
          </div>
          <fieldset>
            <legend class="visually-hidden">Student age</legend>
            <label class="field-label age-field">
              Student age
              <input type="number" name="student_age" id="studentAge" min="2" max="99" inputmode="numeric" required />
            </label>
            <p class="field-help" id="ageHelp" hidden></p>
          </fieldset>
          <div class="step-actions">
            <button class="text-button" type="button" data-back="1">Back</button>
            <button class="btn-a next-button" id="ageNext" type="button">Continue</button>
          </div>
        </div>

        <div class="step-panel" data-step="3" hidden>
          <div class="step-heading" tabindex="-1">
            <span class="step-kicker">Your preferred school</span>
            <h2 id="locationHeading">Where would you like to take lessons?</h2>
            <p>You can change locations later if another schedule works better.</p>
          </div>
          <fieldset>
            <legend class="visually-hidden">Choose a CSM location</legend>
            <div class="location-grid">
              {locations.map((location) => (
                <label class="choice-card location-card">
                  <input type="radio" name="preferred_location" value={location.slug} required />
                  <span>{location.name.replace('CSM ', '')}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <button class="text-button back-alone" type="button" data-back="2">Back</button>
          <p class="selection-hint">Your selection will take you to the next question.</p>
        </div>

        <div class="step-panel" data-step="4" hidden>
          <div class="step-heading" tabindex="-1">
            <span class="step-kicker">Almost there</span>
            <h2>Who should we help?</h2>
            <p>We’ll save these details before showing your booking options, so our team can help if you need us.</p>
          </div>
          <fieldset class="details-fields">
            <legend class="visually-hidden">Parent and student contact details</legend>
            <div class="field-grid name-grid">
              <label class="field-label">
                Parent or guardian name
                <input type="text" name="parent_name" autocomplete="name" maxlength="160" required />
              </label>
              <label class="field-label">
                Student name
                <input type="text" name="student_name" autocomplete="off" maxlength="160" required />
              </label>
            </div>
            <div class="field-grid contact-grid">
              <label class="field-label">
                Email
                <input type="email" name="parent_email" autocomplete="email" maxlength="254" required />
              </label>
              <label class="field-label">
                Mobile phone
                <input type="tel" name="parent_phone" autocomplete="tel" inputmode="tel" maxlength="40" required />
              </label>
            </div>
            <label class="field-label availability-field">
              When are you usually available?
              <select name="preferred_time_window" required>
                <option value="">Choose what usually works</option>
                <option>Weekday mornings</option>
                <option>Weekday afternoons</option>
                <option>Weekday evenings</option>
                <option>Saturday</option>
                <option>Flexible / not sure</option>
              </select>
            </label>
            <div class="family-question">
              <span class="field-question">Have you taken lessons at CSM before?</span>
              <div class="choice-row family-choice">
                <label class="choice-card">
                  <input type="radio" name="existing_family" value="no" required />
                  <span>No, we’re new to CSM</span>
                </label>
                <label class="choice-card">
                  <input type="radio" name="existing_family" value="yes" required />
                  <span>Yes, we’re a CSM family</span>
                </label>
              </div>
            </div>
          </fieldset>
          <div class="form-error" id="formError" role="alert" aria-live="polite"></div>
          <div class="step-actions">
            <button class="text-button" type="button" data-back="3">Back</button>
            <button class="btn-a next-button" id="saveButton" type="submit">Save & Continue</button>
          </div>
          <p class="submit-help">Your intro is free. Nothing is reserved or charged on this page.</p>
        </div>

        <div class="step-panel" data-step="5" hidden>
          <div class="saved-banner">
            <span aria-hidden="true">✓</span>
            <p><strong>Your information is saved.</strong> <span id="savedLeadReference"></span></p>
          </div>

          <div id="newFamilyDecision">
            <div class="step-heading" tabindex="-1">
              <span class="step-kicker">Choose what works for you</span>
              <h2>How would you like to get started?</h2>
              <p>Book online now, or let our team help match the student with the best available teacher and time.</p>
            </div>
            <div class="decision-grid">
              <article class="decision-card decision-primary">
                <span class="decision-label">Fastest</span>
                <h3>See Available Times</h3>
                <p>View live intro openings at your selected CSM location and reserve one now.</p>
                <button class="btn-a decision-button" id="onlineBookingButton" type="button">Book My Free Intro</button>
              </article>
              <article class="decision-card">
                <span class="decision-label">Personal help</span>
                <h3>Have Our Team Find a Fit</h3>
                <p>We’ll review your preferences and follow up to help find the right teacher and time.</p>
                <button class="btn-b decision-button" id="officeHelpButton" type="button">Have CSM Help Me</button>
              </article>
            </div>
          </div>

          <div class="completion-message" id="officeHelpSuccess" hidden tabindex="-1">
            <span class="section-label">You’re all set</span>
            <h2>We’ll help you from here.</h2>
            <p id="officeHelpCopy">Our team has your information and will follow up to help find the best lesson fit.</p>
            <div class="support-actions">
              <a href="tel:5135609175">Call (513) 560-9175</a>
              <a href="sms:5135609175">Text CSM</a>
            </div>
          </div>

          <div class="form-error decision-error" id="decisionError" role="alert" aria-live="polite"></div>
        </div>

        <div class="help-line">
          <span>Would you rather talk with us?</span>
          <a href="tel:5135609175">Call (513) 560-9175</a>
          <a href="sms:5135609175">Text CSM</a>
        </div>
      </form>
    </div>
  </section>

  <style>
    .booking-hero{background:linear-gradient(135deg,var(--charcoal) 0%,#292a2b 62%,#34383b 100%);color:var(--white);position:relative;overflow:hidden}
    .booking-hero::after{content:"";position:absolute;width:390px;height:390px;border:1px solid rgba(255,255,255,.075);border-radius:50%;right:-120px;top:-190px;box-shadow:0 0 0 72px rgba(255,255,255,.025),0 0 0 144px rgba(255,255,255,.017)}
    .booking-hero-inner{width:min(100% - 48px,820px);margin:0 auto;padding:64px 0 56px;position:relative;z-index:1}
    .booking-hero .section-label{color:var(--slate-lt)}
    .booking-hero h1{color:var(--white);max-width:720px;margin:0 0 14px}
    .intro-copy{color:rgba(255,255,255,.77);max-width:650px;font-size:.98rem;line-height:1.7;margin:0}
    .intro-reassurance{display:inline-block;color:rgba(255,255,255,.86);font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin:18px 0 0;padding:8px 12px;border:1px solid rgba(255,255,255,.18)}
    .booking-section{background:linear-gradient(180deg,var(--offwhite) 0%,#fff 42%);padding:56px 24px 90px}
    .booking-column{width:min(100%,820px);margin:0 auto}
    .booking-card{border:1px solid var(--offwb);background:var(--white);padding:0 52px 34px;box-shadow:0 20px 58px rgba(28,30,32,.065);overflow:hidden}
    .progress-wrap{margin:0 -52px 0;padding:25px 52px 24px;background:#faf9f7;border-bottom:1px solid var(--offwb)}
    .progress-copy{display:flex;justify-content:space-between;gap:20px;margin-bottom:17px;font-size:.66rem;font-weight:600;letter-spacing:.085em;text-transform:uppercase;color:#77736e}
    .progress-copy span:last-child{color:var(--accent-dk);text-align:right}
    .progress-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0;list-style:none;margin:0;padding:0}
    .progress-steps li{position:relative;display:flex;align-items:center;gap:8px;color:#99948e;font-size:.66rem;text-transform:uppercase;letter-spacing:.045em}
    .progress-steps li::after{content:"";height:1px;background:#dcd8d3;position:absolute;left:28px;right:6px;top:12px}
    .progress-steps li:last-child::after{display:none}
    .progress-steps span{position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:center;width:25px;height:25px;border:1px solid #ccc7c1;border-radius:50%;background:#faf9f7;font-size:.62rem;font-weight:600}
    .progress-steps small{position:relative;z-index:1;background:#faf9f7;padding-right:7px;font:inherit}
    .progress-steps li.is-complete,.progress-steps li.is-current{color:var(--charcoal)}
    .progress-steps li.is-complete span{border-color:var(--slate);background:var(--slate);color:var(--white)}
    .progress-steps li.is-current span{border-color:var(--accent);background:var(--accent);color:var(--white)}
    .step-panel{padding:42px 0 12px;animation:step-in .24s ease both}
    .step-panel[hidden]{display:none}
    @keyframes step-in{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
    .step-heading{outline:0;margin-bottom:29px}
    .step-kicker,.decision-label{display:block;margin-bottom:9px;color:var(--accent-dk);font-size:.66rem;font-weight:600;letter-spacing:.095em;text-transform:uppercase}
    .step-heading h2{font-size:1.85rem;margin:0 0 9px}
    .step-heading p{font-size:.91rem;line-height:1.65;margin:0;color:#66635f;max-width:650px}
    fieldset{border:0;margin:0;padding:0}
    .field-grid{display:grid;gap:18px}
    .name-grid,.contact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .contact-grid,.availability-field,.family-question{margin-top:18px}
    .field-label{display:flex;flex-direction:column;gap:8px;font-size:.7rem;font-weight:600;letter-spacing:.095em;text-transform:uppercase;color:var(--mid)}
    .field-label input,.field-label select{width:100%;min-height:52px;border:1px solid #d9d7d3;background:var(--white);color:var(--charcoal);font:inherit;font-size:.95rem;font-weight:400;letter-spacing:0;text-transform:none;padding:13px 14px;border-radius:0;transition:border-color .16s,box-shadow .16s}
    .field-label input:focus,.field-label select:focus{outline:0;border-color:var(--accent);box-shadow:0 0 0 3px rgba(247,79,87,.13)}
    .age-field{max-width:240px}
    .field-help,.selection-hint{font-size:.8rem;line-height:1.6;margin:11px 0 0;color:#6d6a65}
    .selection-hint{text-align:center;margin-top:17px}
    .field-question{display:block;margin-bottom:10px;font-size:.7rem;font-weight:600;letter-spacing:.095em;text-transform:uppercase;color:var(--mid)}
    .choice-row,.service-grid,.location-grid{display:grid;gap:12px}
    .choice-row{grid-template-columns:repeat(2,minmax(0,1fr))}
    .service-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
    .location-grid{grid-template-columns:repeat(5,minmax(0,1fr))}
    .choice-card{position:relative;display:block;cursor:pointer}
    .choice-card input{position:absolute;opacity:0;pointer-events:none}
    .choice-card span{display:flex;align-items:center;gap:10px;min-height:58px;border:1px solid #ddd9d5;background:var(--offwhite);padding:14px 15px;font-size:.79rem;color:var(--mid);line-height:1.4;transition:border-color .16s,background .16s,color .16s,box-shadow .16s,transform .16s}
    .choice-card:hover span{border-color:#bbb5ae;transform:translateY(-1px)}
    .choice-card span::before{content:"";flex:0 0 auto;width:14px;height:14px;border:1px solid #aaa6a1;border-radius:50%;background:var(--white);box-shadow:inset 0 0 0 3px var(--white)}
    .choice-card input:checked + span{border-color:var(--accent);background:#fff7f7;color:var(--charcoal);box-shadow:inset 0 0 0 1px var(--accent)}
    .choice-card input:checked + span::before{border-color:var(--accent);background:var(--accent)}
    .choice-card input:focus-visible + span{outline:3px solid rgba(247,79,87,.2);outline-offset:2px}
    .service-card span,.location-card span{justify-content:center;min-height:74px;padding:19px 13px}
    .step-actions{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:32px}
    .next-button{border:0;cursor:pointer;min-width:210px;font-family:inherit;font-size:.74rem}
    .next-button:disabled,.decision-button:disabled{opacity:.6;cursor:wait}
    .text-button{border:0;background:transparent;color:var(--slate);padding:10px 0;font:inherit;font-size:.72rem;font-weight:600;letter-spacing:.075em;text-transform:uppercase;cursor:pointer;text-decoration:underline;text-decoration-color:#c8c3bd;text-underline-offset:4px}
    .back-alone{display:block;margin-top:26px}
    .form-error{min-height:24px;color:var(--accent-dk);font-size:.8rem;margin:19px 0 0}
    .submit-help{text-align:right;font-size:.76rem;line-height:1.55;margin:10px 0 0;color:#66635f}
    .saved-banner{display:flex;align-items:center;gap:13px;padding:14px 16px;margin-bottom:31px;background:#f3f7f4;border:1px solid #d7e5db;color:#31533a}
    .saved-banner>span{display:inline-flex;align-items:center;justify-content:center;width:25px;height:25px;border-radius:50%;background:#3e7450;color:#fff;font-size:.7rem;font-weight:700}
    .saved-banner p{margin:0;font-size:.8rem;line-height:1.45}
    .decision-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    .decision-card{display:flex;flex-direction:column;border:1px solid #dad6d1;background:#faf9f7;padding:27px 25px;min-height:270px}
    .decision-card.decision-primary{border-color:#ffc4c7;background:#fff8f8}
    .decision-card h3{font-size:1.15rem;margin:0 0 10px}
    .decision-card p{font-size:.84rem;line-height:1.65;color:#68645f;margin:0 0 24px}
    .decision-button{margin-top:auto;width:100%;border:0;cursor:pointer;font-family:inherit;text-align:center}
    .completion-message{padding:12px 0 5px;outline:0}
    .completion-message h2{font-size:1.85rem;margin:7px 0 13px}
    .completion-message p{font-size:.94rem;line-height:1.7;color:var(--mid);max-width:620px}
    .support-actions{display:flex;gap:18px;margin-top:24px}
    .support-actions a{color:var(--slate);font-size:.72rem;font-weight:600;letter-spacing:.075em;text-transform:uppercase;text-decoration:none}
    .decision-error{margin-bottom:0}
    .help-line{display:flex;align-items:center;flex-wrap:wrap;gap:7px 18px;margin-top:31px;padding-top:22px;border-top:1px solid var(--offwb);font-size:.73rem}
    .help-line span{color:var(--mid)}
    .help-line a{color:var(--slate);font-weight:600;text-decoration:none}
    .hidden-field{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
    .visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
    @media(max-width:760px){.progress-steps small{display:none}.progress-steps li::after{right:5px}.progress-steps li{gap:0}.location-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media(max-width:620px){.booking-hero-inner{width:min(100% - 40px,820px);padding:50px 0 44px}.booking-section{padding:28px 14px 64px}.booking-card{padding:0 22px 28px}.progress-wrap{margin:0 -22px;padding:20px 22px}.step-panel{padding-top:34px}.step-heading h2,.completion-message h2{font-size:1.5rem}.name-grid,.contact-grid,.choice-row,.service-grid,.location-grid,.decision-grid{grid-template-columns:1fr}.service-grid,.location-grid{gap:9px}.service-card span,.location-card span{justify-content:flex-start;min-height:58px;padding:14px}.step-actions{align-items:stretch;flex-direction:column-reverse}.next-button{width:100%}.text-button{text-align:center}.submit-help{text-align:left}.decision-card{min-height:0}.help-line,.support-actions{align-items:flex-start;flex-direction:column}.progress-copy{font-size:.6rem}}
  </style>

  <script define:vars={{ services, locations, bookingRoutes }}>
    (function(){
      var form = document.getElementById('introBridgeForm');
      if(!form) return;

      var params = new URLSearchParams(window.location.search);
      var panels = Array.from(form.querySelectorAll('.step-panel'));
      var progressItems = Array.from(document.querySelectorAll('#progressSteps li'));
      var progressEyebrow = document.getElementById('progressEyebrow');
      var progressStatus = document.getElementById('progressStatus');
      var errorBox = document.getElementById('formError');
      var decisionError = document.getElementById('decisionError');
      var saveButton = document.getElementById('saveButton');
      var onlineButton = document.getElementById('onlineBookingButton');
      var officeButton = document.getElementById('officeHelpButton');
      var age = document.getElementById('studentAge');
      var ageHelp = document.getElementById('ageHelp');
      var serviceChoices = form.querySelectorAll('input[name="service_slug"]');
      var locationChoices = form.querySelectorAll('input[name="preferred_location"]');
      var submissionIdField = document.getElementById('clientSubmissionId');
      var submittedAtField = document.getElementById('submittedAt');
      var attributionField = document.getElementById('attributionJson');
      var currentStep = 1;
      var savedResult = null;
      var transitionTimer = null;
      var stepLabels = ['Choose a lesson','Student age','Preferred location','Your details','Choose what’s next'];

      function selectedService(){
        var selected = form.querySelector('input[name="service_slug"]:checked');
        return services.find(function(service){ return selected && service.slug === selected.value; }) || null;
      }
      function selectedLocation(){
        var selected = form.querySelector('input[name="preferred_location"]:checked');
        return locations.find(function(location){ return selected && location.slug === selected.value; }) || null;
      }
      function randomId(){
        if(window.crypto && typeof window.crypto.randomUUID === 'function') return 'intro-bridge-' + window.crypto.randomUUID().replace(/-/g,'');
        return 'intro-bridge-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2,14);
      }
      function attribution(){
        if(window.CSMAttribution && typeof window.CSMAttribution.getLatest === 'function') return window.CSMAttribution.getLatest() || {};
        try {
          var stored = JSON.parse(window.localStorage.getItem('csmAttribution') || '{}') || {};
          var first = stored.first_touch || {};
          var latest = stored.latest_touch || first || {};
          return Object.assign({}, latest, {
            first_landing_path: first.first_landing_path || first.latest_landing_path || '',
            latest_landing_path: latest.latest_landing_path || latest.first_landing_path || '',
            last_paid_click_timestamp: stored.last_paid_click_timestamp || ''
          });
        } catch(error){ return {}; }
      }
      function isExistingFamily(){
        var selected = form.querySelector('input[name="existing_family"]:checked');
        return selected && selected.value === 'yes';
      }
      function decorateBookingUrl(url){
        if(window.CSMAttribution && typeof window.CSMAttribution.decorateUrl === 'function') return window.CSMAttribution.decorateUrl(url);
        return url;
      }
      function showStep(step, options){
        currentStep = Math.max(1, Math.min(5, Number(step) || 1));
        panels.forEach(function(panel){
          var active = Number(panel.dataset.step) === currentStep;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
        progressItems.forEach(function(item, index){
          item.classList.toggle('is-complete', index + 1 < currentStep);
          item.classList.toggle('is-current', index + 1 === currentStep);
        });
        progressEyebrow.textContent = 'Step ' + currentStep + ' of 5';
        progressStatus.textContent = stepLabels[currentStep - 1];
        if(!options || options.focus !== false){
          var activeHeading = form.querySelector('.step-panel[data-step="' + currentStep + '"] .step-heading');
          if(activeHeading) activeHeading.focus({ preventScroll: true });
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      function scheduleStep(step){
        window.clearTimeout(transitionTimer);
        transitionTimer = window.setTimeout(function(){ showStep(step); }, 170);
      }
      function validateControl(control){
        if(!control.checkValidity()){
          control.reportValidity();
          control.focus();
          return false;
        }
        return true;
      }
      function syncServiceCopy(){
        var service = selectedService();
        if(!service) return;
        document.getElementById('heroHeading').textContent = 'Find Your Free ' + service.introName;
        document.getElementById('locationHeading').textContent = 'Where would you like to take ' + service.name.toLowerCase() + ' lessons?';
        age.min = String(service.ageMin);
        age.max = String(service.ageMax);
        if(service.ageMin > 2 || service.ageMax < 99){
          ageHelp.textContent = service.ageMax >= 99
            ? service.name + ' lessons are available for ages ' + service.ageMin + ' and up.'
            : service.ageMin === service.ageMax
              ? service.name + ' is designed for age ' + service.ageMin + '.'
              : service.name + ' is designed for ages ' + service.ageMin + '–' + service.ageMax + '.';
          ageHelp.hidden = false;
        } else ageHelp.hidden = true;
      }
      function validateAge(){
        var service = selectedService();
        if(!service){ showStep(1); return false; }
        if(!validateControl(age)) return false;
        var studentAge = Number(age.value);
        if(studentAge < service.ageMin || studentAge > service.ageMax){
          age.setCustomValidity(service.ageMax >= 99
            ? service.name + ' is available for students age ' + service.ageMin + ' and up.'
            : service.name + ' is available for students between ages ' + service.ageMin + ' and ' + service.ageMax + '.');
          age.reportValidity();
          age.setCustomValidity('');
          return false;
        }
        return true;
      }
      function validateDetails(){
        errorBox.textContent = '';
        var controls = Array.from(form.querySelectorAll('.step-panel[data-step="4"] input[required], .step-panel[data-step="4"] select[required]'));
        for(var i = 0; i < controls.length; i += 1){
          if(!validateControl(controls[i])) return false;
        }
        if(!selectedService()){ showStep(1); return false; }
        if(!selectedLocation()){ showStep(3); return false; }
        return validateAge();
      }
      async function recordChoice(choice){
        if(!savedResult) throw new Error('Your information has not been saved yet.');
        var controller = new AbortController();
        var timeout = window.setTimeout(function(){ controller.abort(); }, 5000);
        try {
          var response = await fetch('/api/intro-bridge-choice', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              lead_id: savedResult.lead_id,
              client_submission_id: submissionIdField.value,
              choice: choice
            }),
            signal: controller.signal
          });
          var result = await response.json().catch(function(){ return {}; });
          if(!response.ok || !result.ok) throw new Error(result.error || 'We could not record your choice.');
          return result;
        } finally {
          window.clearTimeout(timeout);
        }
      }
      function showOfficeSuccess(existingFamily){
        document.getElementById('newFamilyDecision').hidden = true;
        var completion = document.getElementById('officeHelpSuccess');
        document.getElementById('officeHelpCopy').textContent = existingFamily
          ? 'Since you already have a CSM account, our office will help arrange the intro without creating a duplicate account. We’ll follow up with you.'
          : 'Our team has your information and will follow up to help find the best teacher and time.';
        completion.hidden = false;
        completion.focus();
      }
      async function requestOfficeHelp(existingFamily){
        decisionError.textContent = '';
        officeButton.disabled = true;
        officeButton.textContent = 'Sending to our team…';
        try {
          await recordChoice('office_help');
          showOfficeSuccess(existingFamily);
        } catch(error){
          decisionError.textContent = error.name === 'AbortError'
            ? 'Your information is saved, but this request took too long. Please call or text CSM at (513) 560-9175.'
            : (error.message || 'Your information is saved. Please call or text CSM at (513) 560-9175.');
          officeButton.disabled = false;
          officeButton.textContent = 'Have CSM Help Me';
        }
      }

      submissionIdField.value = randomId();
      var requestedService = params.get('service') || '';
      var requestedLocation = params.get('location') || '';
      var presetService = form.querySelector('input[name="service_slug"][value="' + CSS.escape(requestedService) + '"]');
      var presetLocation = form.querySelector('input[name="preferred_location"][value="' + CSS.escape(requestedLocation) + '"]');
      if(presetService) presetService.checked = true;
      if(presetLocation) presetLocation.checked = true;
      if(presetService) syncServiceCopy();

      serviceChoices.forEach(function(choice){
        choice.addEventListener('change', function(){ syncServiceCopy(); scheduleStep(2); });
      });
      locationChoices.forEach(function(choice){
        choice.addEventListener('change', function(){ scheduleStep(4); });
      });
      form.querySelectorAll('[data-back]').forEach(function(button){
        button.addEventListener('click', function(){ showStep(button.dataset.back); });
      });
      age.addEventListener('input', function(){ age.setCustomValidity(''); });
      age.addEventListener('keydown', function(event){
        if(event.key === 'Enter'){
          event.preventDefault();
          document.getElementById('ageNext').click();
        }
      });
      document.getElementById('ageNext').addEventListener('click', function(){
        if(!validateAge()) return;
        showStep(presetLocation && presetLocation.checked ? 4 : 3);
      });

      onlineButton.addEventListener('click', async function(){
        decisionError.textContent = '';
        onlineButton.disabled = true;
        onlineButton.textContent = 'Opening available times…';
        var destination = savedResult && savedResult.booking_url
          ? savedResult.booking_url
          : bookingRoutes[selectedService().slug][selectedLocation().slug];
        try {
          await recordChoice('online_booking');
        } catch(error){
          console.warn('Intro handoff choice was not recorded before Opus navigation.', error);
        }
        window.location.assign(decorateBookingUrl(destination));
      });
      officeButton.addEventListener('click', function(){ requestOfficeHelp(false); });

      form.addEventListener('submit', async function(event){
        event.preventDefault();
        if(savedResult){ showStep(5); return; }
        if(!validateDetails()) return;
        saveButton.disabled = true;
        saveButton.textContent = 'Saving your information…';
        submittedAtField.value = new Date().toISOString();
        attributionField.value = JSON.stringify(attribution());
        try {
          var payload = Object.fromEntries(new FormData(form).entries());
          var response = await fetch('/api/intro-bridge-submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          var result = await response.json().catch(function(){ return {}; });
          if(!response.ok || !result.ok || !result.stored) throw new Error(result.error || 'We couldn’t save your information.');
          savedResult = result;
          document.getElementById('savedLeadReference').textContent = 'Reference ' + result.lead_id + '.';
          showStep(5);
          if(result.existing_family) requestOfficeHelp(true);
        } catch(error){
          errorBox.textContent = error.message || 'We couldn’t save your information. Please call or text CSM at (513) 560-9175.';
          saveButton.disabled = false;
          saveButton.textContent = 'Save & Continue';
        }
      });

      showStep(presetService ? 2 : 1, { focus: false });
    })();
  </script>
</Base>
