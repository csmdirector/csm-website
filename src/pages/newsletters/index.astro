---
import Base from '../../layouts/Base.astro';
const issues = [
  {
    "month": "November 2026",
    "title": "I Didn’t Thank Her Enough",
    "path": "/newsletters/november-2026/",
    "image": "/images/newsletters/joe-early-piano.jpeg",
    "alt": "Joe during his early piano studies",
    "description": "Joe on his mom and what he appreciates more now. Plus our Halloween winner, food drive, winter recital news, and October welcomes."
  },
  {
    "month": "October 2026",
    "title": "Halloween at CSM",
    "path": "/newsletters/october-2026/",
    "image": "/images/newsletters/october-2026-02.jpg",
    "alt": "A student dressed as Sonic playing violin",
    "description": "The Halloween costume contest, teacher spotlight George, student photos, October recitals, and practice advice for parents."
  },
  {
    "month": "September 2026",
    "title": "Meet Ella & the Progress You Can’t Hear Yet",
    "path": "/newsletters/september-2026/",
    "image": "/images/newsletters/september-2026-01.jpg",
    "alt": "Joe and Anna Backer with their family",
    "description": "A note from Anna and Joe, student spotlight Ella, signs of musical progress, studio photos, and September dates."
  }
];
---
<Base title="CSM Newsletters | Cincinnati School of Music" description="News, student celebrations, upcoming dates, and notes from Anna and Joe at Cincinnati School of Music." canonicalPath="/newsletters/">
<section class="newsletter-archive"><div class="archive-inner"><p class="label">Cincinnati School of Music</p><h1>CSM Newsletters</h1><p class="intro">Notes from Anna and Joe, student celebrations, and what’s coming up at CSM.</p>
{issues.map(issue => <a class="issue" href={issue.path}><img src={issue.image} alt={issue.alt} loading="lazy" /><div class="issue-copy"><p class="label">{issue.month}</p><h2>{issue.title}</h2><p>{issue.description}</p><span>Read the newsletter →</span></div></a>)}
</div></section>
</Base>
<style>
.newsletter-archive{background:#f6efe6;min-height:70vh;padding:72px 24px 96px}.archive-inner{max-width:980px;margin:auto}.label{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#9b4f2d}.newsletter-archive h1{font-family:Georgia,'Times New Roman',serif;font-weight:400;color:#5a2f22;margin:16px 0;font-size:clamp(36px,5vw,52px)}.intro{font-size:18px;color:#6a574b;max-width:620px;margin-bottom:40px}.issue{margin-top:28px;display:grid;grid-template-columns:1fr 1.15fr;text-decoration:none;background:#fffdfa;border:1px solid #e9dacc;transition:box-shadow .2s}.issue:hover{box-shadow:0 10px 30px #5a2f2215}.issue:focus-visible{outline:3px solid #9b4f2d;outline-offset:5px}.issue img{display:block;width:100%;height:auto}.issue-copy{align-self:center;padding:40px}.issue-copy h2{font-family:Georgia,'Times New Roman',serif;font-weight:400;color:#5a2f22;font-size:36px;margin:14px 0 20px}.issue-copy p{color:#6a574b;font-size:16px;line-height:1.8}.issue-copy .label{font-size:11px;color:#9b4f2d}.issue-copy span{display:block;margin-top:26px;color:#9b4f2d;font-weight:500;font-size:15px}@media(max-width:640px){.newsletter-archive{padding:44px 20px 60px}.issue{grid-template-columns:1fr}.issue-copy{padding:28px}.intro{font-size:17px}}
</style>
