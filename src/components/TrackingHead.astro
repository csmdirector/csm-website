    return parsed.pathname + (query ? '?' + query : '');
  }

  function safeReferrer(value){
    if(!value) return '';
    try {
      var parsed = new URL(value);
      return parsed.origin + parsed.pathname;
    } catch (error) {
      return trim(String(value).split('#')[0].split('?')[0]);
    }
  }

  function getParamSnapshot(){
    var params = new URLSearchParams(window.location.search);
    var snapshot = {};
    PARAM_KEYS.forEach(function(key){
      var value = params.get(key);
      if(value && trim(value)){
        snapshot[key] = trim(value);
      }
    });
    return snapshot;
  }

  function hasAnyTracking(snapshot){
    return PARAM_KEYS.some(function(key){ return Boolean(snapshot[key]); });
  }

  function hasPaidClick(snapshot){
    if(CLICK_ID_KEYS.some(function(key){ return Boolean(snapshot[key]); })) return true;
    return /^(cpc|ppc|paid|paid[-_ ]?search|sem)$/i.test(snapshot.utm_medium || '');
  }

  function freshTouch(touch){
    var time = parseTimestamp(touch && touch.timestamp);
    return time > 0 && time <= Date.now() + 60000 && Date.now() - time < TTL_MS;
  }

  function sameClick(left, right){
    return CLICK_ID_KEYS.some(function(key){ return left && right && left[key] && left[key] === right[key]; });
  }

  function sameCampaign(left, right){
    return PARAM_KEYS.every(function(key){ return (left && left[key] || '') === (right && right[key] || ''); });
  }

  function pruneExpired(stored){
    stored = stored || {};
    // Expire each actual touch, not 90 days after the most recent page view.
    ['first_touch','latest_touch','last_paid_touch'].forEach(function(key){
      if(!freshTouch(stored[key])) delete stored[key];
    });
    if(!stored.first_touch && stored.latest_touch){
      stored.latest_touch.first_landing_path = stored.latest_touch.latest_landing_path || '';
      stored.first_touch = stored.latest_touch;
    }
    if(!stored.latest_touch && stored.first_touch) stored.latest_touch = stored.first_touch;
    if(stored.last_paid_touch) stored.last_paid_click_timestamp = stored.last_paid_touch.timestamp;
    else delete stored.last_paid_click_timestamp;
    return stored;
  }

  function parseTimestamp(value){
    var timestamp = Date.parse(value || '');
    return Number.isFinite(timestamp) ? timestamp : 0;
  }

  function getLegacyTimestamp(legacy){
    return parseTimestamp(legacy.timestamp) ||
      parseTimestamp(legacy.attribution_timestamp) ||
      parseTimestamp(legacy.last_paid_click_timestamp);
  }

  function isLegacyFreshEnough(legacy){
    var timestamp = getLegacyTimestamp(legacy);
    if(!timestamp) return false;
    return timestamp <= Date.now() + 60000 && Date.now() - timestamp < TTL_MS;
  }

  function buildTouch(snapshot, landingPath, referrer, timestamp){
    var touch = {
      timestamp: timestamp,
      referrer: referrer,
      first_landing_path: landingPath,
      latest_landing_path: landingPath
    };
    PARAM_KEYS.forEach(function(key){
      touch[key] = snapshot[key] || '';
    });
    touch.source_type = hasAnyTracking(snapshot) ? 'campaign' : 'direct';
    if(!hasAnyTracking(snapshot) && referrer){
      try { if(new URL(referrer).origin !== window.location.origin) touch.source_type = 'referral'; } catch (error) {}
    }
    return touch;
  }

  function migrateLegacy(stored){
    // A primary store that expired must not be revived from its legacy copy.
    if(stored.version || stored.first_touch || stored.latest_touch) return stored;
    var legacy = readJson(LEGACY_LESSON_FIT_KEY, 'localStorage');
    if(!legacy || !Object.keys(legacy).length) return stored;
    if(!isLegacyFreshEnough(legacy)){
      removeJson(LEGACY_LESSON_FIT_KEY, 'localStorage');
      return stored;
    }
    var timestamp = new Date(getLegacyTimestamp(legacy)).toISOString();
    var latestPath = safePath(legacy.latest_landing_path || legacy.landing_path || legacy.first_landing_path || '');
    var firstPath = safePath(legacy.first_landing_path || latestPath);
    var touch = buildTouch(legacy, latestPath, safeReferrer(legacy.referrer || ''), timestamp);
    touch.first_landing_path = firstPath;
    touch.latest_landing_path = latestPath;
    stored.first_touch = touch;
    stored.latest_touch = touch;
    stored.created_at = timestamp;
    stored.updated_at = timestamp;
    if(hasPaidClick(legacy)){
      stored.last_paid_touch = Object.assign({}, touch);
      stored.last_paid_click_timestamp = timestamp;
    }
    return stored;
  }

  function getStore(){
    var stored = readJson(STORAGE_KEY, 'localStorage');
    // Upgrade known v2 evidence. Never invent a click from a timestamp alone.
    if(stored.version !== 3 && !stored.last_paid_touch){
      var candidates = [stored.latest_touch, stored.first_touch].filter(function(touch){ return parseTimestamp(touch && touch.timestamp) > 0 && hasPaidClick(touch); });
      if(candidates.length){
        var paid = candidates[0];
        candidates.forEach(function(touch){ if(sameClick(touch, paid) && parseTimestamp(touch.timestamp) < parseTimestamp(paid.timestamp)) paid = touch; });
        if(sameClick(stored.latest_touch, paid)) stored.latest_touch.timestamp = paid.timestamp;
        stored.last_paid_touch = Object.assign({}, paid);
      }
    }
    return pruneExpired(migrateLegacy(pruneExpired(stored)));
  }

  function normalizeFlat(stored){
    stored = stored || getStore();
    var first = stored.first_touch || {};
    var latest = stored.latest_touch || first || {};
    var flat = {};
    PARAM_KEYS.forEach(function(key){
      flat[key] = latest[key] || '';
    });
    flat.first_landing_path = first.first_landing_path || first.latest_landing_path || '';
    flat.latest_landing_path = latest.latest_landing_path || latest.first_landing_path || flat.first_landing_path || '';
    flat.landing_path = flat.latest_landing_path;
    flat.referrer = latest.referrer || first.referrer || '';
    flat.timestamp = latest.timestamp || stored.updated_at || '';
    var paid = stored.last_paid_touch || {};
    PARAM_KEYS.forEach(function(key){ flat['last_paid_' + key] = paid[key] || ''; });
    flat.last_paid_click_timestamp = paid.timestamp || '';
    flat.last_paid_landing_path = paid.latest_landing_path || paid.first_landing_path || '';
    flat.last_paid_referrer = paid.referrer || '';
    flat.attribution_timestamp = flat.timestamp;
    flat.source_type = latest.source_type || '';
    return flat;
  }

  function syncLegacy(flat){
    if(hasAnyTracking(flat)){
      writeJson(LEGACY_LESSON_FIT_KEY, flat, 'localStorage');
    } else {
      removeJson(LEGACY_LESSON_FIT_KEY, 'localStorage');
