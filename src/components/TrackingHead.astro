    // independent paid touch. Do not reinterpret it as the latest source.
    if(internal && !stored.last_paid_touch){
      var carriedPaid = { timestamp: params.get('last_paid_click_timestamp') || '' };
      PARAM_KEYS.forEach(function(key){ carriedPaid[key] = trim(params.get('last_paid_' + key)); });
      carriedPaid.latest_landing_path = safePath(params.get('last_paid_landing_path') || '');
      carriedPaid.first_landing_path = carriedPaid.latest_landing_path;
      carriedPaid.referrer = safeReferrer(params.get('last_paid_referrer') || '');
      carriedPaid.source_type = 'campaign';
      if(freshTouch(carriedPaid) && hasPaidClick(carriedPaid)) stored.last_paid_touch = carriedPaid;
    }
    // A decorated internal navigation is the same arrival, not a new ad click.
    var carriedTimestamp = internal || sameCampaign(snapshot, stored.latest_touch) ? params.get('attribution_timestamp') : '';
    var carried = parseTimestamp(carriedTimestamp);
    if(carried && (Date.now() - carried >= TTL_MS || carried > Date.now() + 60000)){
      snapshot = {}; hasTracking = false; paidClick = false;
    }
    var priorPaid = stored.last_paid_touch;
    var samePaidClick = paidClick && sameClick(snapshot, priorPaid);
    var sameInternalCampaign = internal && sameCampaign(snapshot, stored.latest_touch);
    if(samePaidClick) timestamp = priorPaid.timestamp;
    else if(carried && hasTracking) timestamp = new Date(carried).toISOString();

    if(firstVisit){
      var initialTouch = buildTouch(snapshot, landingPath, referrer, timestamp);
      if(internal && carried && hasTracking){
        initialTouch.first_landing_path = safePath(params.get('first_landing_path') || landingPath);
        initialTouch.latest_landing_path = safePath(params.get('latest_landing_path') || params.get('landing_path') || landingPath);
        initialTouch.referrer = safeReferrer(params.get('referrer') || document.referrer);
      }
      stored.first_touch = initialTouch;
      stored.latest_touch = initialTouch;
    // Latest means the latest campaign or external referral. Direct returns
    // keep the last non-direct source; neither replaces the independent paid touch.
    } else if((hasTracking && !sameInternalCampaign) || (!hasTracking && externalReferral)){
      var latestTouch = buildTouch(snapshot, landingPath, referrer, timestamp);
      latestTouch.first_landing_path = stored.first_touch.first_landing_path || landingPath;
      stored.latest_touch = latestTouch;
    }

    if(paidClick && !samePaidClick && !sameInternalCampaign){
      stored.last_paid_touch = buildTouch(snapshot, landingPath, referrer, timestamp);
    }
    stored = pruneExpired(stored);
    stored.version = 3;
    stored.ttl_days = 90;
    stored.created_at = stored.first_touch && stored.first_touch.timestamp || timestamp;
    stored.updated_at = nowIso();
    var newest = Math.max.apply(null, ['first_touch','latest_touch','last_paid_touch'].map(function(key){ return parseTimestamp(stored[key] && stored[key].timestamp); }));
    stored.expires_at = new Date((newest || Date.now()) + TTL_MS).toISOString();

    var session = readJson(SESSION_KEY, 'sessionStorage');
    if(!session.started_at){
      session = {
        started_at: timestamp,
        entry_path: landingPath,
        referrer: referrer,
        source_type: hasTracking ? 'campaign' : 'direct'
      };
      ['utm_source','utm_medium','utm_campaign'].forEach(function(key){
        if(snapshot[key]) session[key] = snapshot[key];
      });
      writeJson(SESSION_KEY, session, 'sessionStorage');
    }

    writeJson(STORAGE_KEY, stored, 'localStorage');
    capturedHref = window.location.href;
    var flat = normalizeFlat(stored);
    syncLegacy(flat);

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      csm_attribution_gclid: flat.gclid,
      csm_attribution_gbraid: flat.gbraid,
      csm_attribution_wbraid: flat.wbraid,
      csm_attribution_source: flat.utm_source,
      csm_attribution_medium: flat.utm_medium,
      csm_attribution_campaign: flat.utm_campaign,
      csm_attribution_first_landing_path: flat.first_landing_path,
      csm_attribution_latest_landing_path: flat.latest_landing_path,
      csm_attribution_timestamp: flat.timestamp
    });
    return flat;
  }

  function decorateUrl(url){
    var flat = normalizeFlat();
    var outbound;
    try {
      outbound = new URL(url, window.location.origin);
    } catch (error) {
      return url;
    }
    PARAM_KEYS.concat(PAID_KEYS, ['last_paid_click_timestamp','last_paid_landing_path','last_paid_referrer']).forEach(function(key){
      if(flat[key]) outbound.searchParams.set(key, flat[key]);
      else outbound.searchParams.delete(key);
    });
    if(flat.first_landing_path){
      outbound.searchParams.set('first_landing_path', flat.first_landing_path);
    }
    if(flat.latest_landing_path){
      outbound.searchParams.set('latest_landing_path', flat.latest_landing_path);
      outbound.searchParams.set('landing_path', flat.latest_landing_path);
    }
    if(flat.referrer){
      outbound.searchParams.set('referrer', flat.referrer);
    }
    if(flat.timestamp){
      outbound.searchParams.set('attribution_timestamp', flat.timestamp);
    }
    return outbound.toString();
  }

  window.CSMAttribution = {
    capture: capture,
    getStore: getStore,
    getLatest: function(){ return normalizeFlat(); },
    decorateUrl: decorateUrl,
    clear: function(){
      capturedHref = '';
      removeJson(STORAGE_KEY, 'localStorage');
      removeJson(LEGACY_LESSON_FIT_KEY, 'localStorage');
      removeJson(SESSION_KEY, 'sessionStorage');
    }
  };

  capture();
})();
