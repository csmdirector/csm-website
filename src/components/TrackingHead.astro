  var LEGACY_LESSON_FIT_KEY = 'csmLessonFitAttribution';
  var SESSION_KEY = 'csmAttributionSession';
  var PARAM_KEYS = ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'];
  var CLICK_ID_KEYS = ['gclid','gbraid','wbraid'];
  var TTL_MS = 90 * 24 * 60 * 60 * 1000;
  var memory = {};
  var capturedHref = '';
  var PAID_KEYS = PARAM_KEYS.map(function(key){ return 'last_paid_' + key; });

  function trim(value){
    return String(value || '').trim().slice(0, 500);
  }

  function nowIso(){
    return new Date().toISOString();
  }

  // Storage may be blocked entirely (including access to the property itself).
  // Keep this page's attribution usable and carry it on the outgoing URL.
  function readJson(key, storageName){
    if(Object.prototype.hasOwnProperty.call(memory, key)) return memory[key];
    try { return JSON.parse(window[storageName].getItem(key) || '{}') || {}; }
    catch (error) { return memory[key] || {}; }
  }

  function writeJson(key, value, storageName){
    memory[key] = value;
    try { window[storageName].setItem(key, JSON.stringify(value)); } catch (error) {}
  }

  function removeJson(key, storageName){
    memory[key] = {};
    try { window[storageName].removeItem(key); } catch (error) {}
  }

  function safePath(url){
    var parsed;
    try {
      parsed = url ? new URL(url, window.location.origin) : new URL(window.location.href);
    } catch (error) {
      return window.location.pathname || '/';
    }
    var safeParams = new URLSearchParams();
    PARAM_KEYS.forEach(function(key){
      var value = parsed.searchParams.get(key);
      if(value && trim(value)){
        safeParams.set(key, trim(value));
      }
