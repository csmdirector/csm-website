    var landingPath = safePath();
    var referrer = safeReferrer(document.referrer);
    var snapshot = getParamSnapshot();
    var hasTracking = hasAnyTracking(snapshot);
    var paidClick = hasPaidClick(snapshot);
    var stored = getStore();
    var firstVisit = !stored.first_touch;
    var internal = false;
    try { internal = new URL(document.referrer).origin === window.location.origin; } catch (error) {}
    var externalReferral = Boolean(referrer) && !internal;
    var params = new URLSearchParams(window.location.search);
