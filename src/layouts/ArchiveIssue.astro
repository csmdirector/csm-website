---
import Base from './Base.astro';
import NewsletterShare from '../components/NewsletterShare.astro';
interface Props { month: string; title: string; description: string; canonicalPath: string; content: string; image: string; imageAlt: string; imageWidth: number; imageHeight: number; }
const { month, title, description, canonicalPath, content, image, imageAlt, imageWidth, imageHeight } = Astro.props;
const social = { title, description, image, imageAlt, imageWidth, imageHeight };
---
<Base title={`${title} — ${month} Newsletter | Cincinnati School of Music`} description={description} canonicalPath={canonicalPath} social={social}>
  <div class="archive-page">
    <div class="issue-navigation"><a href="/newsletters/">← All newsletters</a><span>{month}</span></div>
    <article class="back-issue">
      <header class="issue-heading">
        <p class="issue-label">Cincinnati School of Music · {month}</p>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <NewsletterShare title={title} caption={description} canonicalPath={canonicalPath} />
      <aside class="archive-notice">From the newsletter archive. Event dates, deadlines, and offers below are from {month}.</aside>
      <div class="archive-content" set:html={content} />
      <NewsletterShare title={title} caption={description} canonicalPath={canonicalPath} />
    </article>
    <a class="archive-return" href="/newsletters/">← Back to newsletters</a>
  </div>
</Base>
<style>
  .archive-page{background:#f6efe6;padding:32px 24px 72px}.issue-navigation{max-width:820px;margin:0 auto 24px;display:flex;justify-content:space-between;gap:16px;font-size:14px}.issue-navigation a,.archive-return{color:#754027;text-underline-offset:4px}.back-issue{max-width:820px;margin:auto;background:#fffdfa;box-shadow:0 8px 40px #5a2f220b}.issue-heading{padding:48px 52px;background:#5a2f22}.issue-heading h1{font-family:Georgia,'Times New Roman',serif;color:#fff8ef;font-weight:400;letter-spacing:-.025em;font-size:clamp(36px,5vw,52px);line-height:1.15;margin:18px 0 22px}.issue-heading p{font-size:17px;line-height:1.7;color:#fff3e4}.issue-heading .issue-label{font-size:11px;text-transform:uppercase;font-weight:500;letter-spacing:.17em;color:#f4ccb0}.archive-notice{padding:20px 52px;background:#efe4d7;color:#6a4835;font-size:14px;line-height:1.7}.archive-content{padding:42px 52px 52px}.archive-return{display:block;max-width:820px;margin:28px auto 0;font-size:14px}
  @media(max-width:600px){.archive-page{padding:20px 12px 48px}.issue-navigation{padding:0 8px;font-size:12px}.issue-heading{padding:32px 24px}.archive-notice{padding:18px 24px}.archive-content{padding:32px 24px 40px}}
</style>
<style is:global>
  .archive-content p{font-family:Arial,Helvetica,sans-serif;color:#382c25;font-size:17px;line-height:1.8;margin:0 0 24px}.archive-content h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(27px,4vw,34px);font-weight:400;color:#5a2f22;line-height:1.3;letter-spacing:-.015em;margin:44px 0 24px}.archive-content h2:first-child{margin-top:0}.archive-content .eyebrow{font-family:var(--f);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.15em;color:#9b4f2d;margin:40px 0 12px}.archive-content .eyebrow+h2{margin-top:0}.archive-content .caption{font-size:13px;line-height:1.6;color:#756353;margin-top:-12px}.archive-content figure{margin:32px 0 24px}.archive-content img{display:block;max-width:100%;width:100%;height:auto}.archive-content a{color:#9b4f2d;text-underline-offset:4px;overflow-wrap:anywhere}.archive-content strong{font-weight:700}.archive-content .photo-gallery{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:32px 0}.archive-content .photo-gallery figure{margin:0}.archive-content .student-names{font-size:15px;line-height:2.2;padding:24px;background:#f6efe6}.archive-content blockquote{font-family:Georgia,'Times New Roman',serif;font-size:25px;line-height:1.5;border-left:3px solid #9b4f2d;padding:8px 0 8px 24px;margin:32px 0;color:#754027}@media(max-width:600px){.archive-content p{font-size:16px}.archive-content .caption{font-size:12px}.archive-content .photo-gallery{gap:12px}.archive-content .student-names{padding:18px}}
</style>
